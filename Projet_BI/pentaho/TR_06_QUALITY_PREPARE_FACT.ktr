  <step>
    <name>Extraction depuis table</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>my_connexion</connection>
    <sql>SELECT
    u.id_adolescent,
    u.age,
    u.gender,
    u.platform_usage,
    sc.social_interaction_level,

    u.daily_social_media_hours,
    u.screen_time_before_sleep,
    w.sleep_hours,
    sc.academic_performance,
    sc.physical_activity,

    w.stress_level,
    w.anxiety_level,
    w.addiction_level,
    w.depression_label,

    CASE
        WHEN u.id_adolescent IS NULL THEN 'REJECT'
        WHEN u.age IS NULL OR u.age &lt; 13 OR u.age > 19 THEN 'REJECT'
        WHEN u.gender IS NULL THEN 'REJECT'
        WHEN u.platform_usage IS NULL THEN 'REJECT'
        WHEN sc.social_interaction_level IS NULL THEN 'REJECT'
        WHEN u.daily_social_media_hours IS NULL OR u.daily_social_media_hours &lt; 0 OR u.daily_social_media_hours > 24 THEN 'REJECT'
        WHEN u.screen_time_before_sleep IS NULL OR u.screen_time_before_sleep &lt; 0 OR u.screen_time_before_sleep > 24 THEN 'REJECT'
        WHEN w.sleep_hours IS NULL OR w.sleep_hours &lt; 0 OR w.sleep_hours > 24 THEN 'REJECT'
        WHEN w.stress_level IS NULL OR w.stress_level &lt; 0 OR w.stress_level > 10 THEN 'REJECT'
        WHEN w.anxiety_level IS NULL OR w.anxiety_level &lt; 0 OR w.anxiety_level > 10 THEN 'REJECT'
        WHEN w.addiction_level IS NULL OR w.addiction_level &lt; 0 OR w.addiction_level > 10 THEN 'REJECT'
        WHEN w.depression_label IS NULL OR w.depression_label NOT IN (0, 1) THEN 'REJECT'
        ELSE 'VALID'
    END AS quality_status,

    CASE
        WHEN u.id_adolescent IS NULL THEN 'Identifiant adolescent manquant'
        WHEN u.age IS NULL OR u.age &lt; 13 OR u.age > 19 THEN 'Age manquant ou hors plage'
        WHEN u.gender IS NULL THEN 'Genre manquant'
        WHEN u.platform_usage IS NULL THEN 'Plateforme manquante'
        WHEN sc.social_interaction_level IS NULL THEN 'Niveau interaction sociale manquant'
        WHEN u.daily_social_media_hours IS NULL OR u.daily_social_media_hours &lt; 0 OR u.daily_social_media_hours > 24 THEN 'Usage quotidien reseaux sociaux invalide'
        WHEN u.screen_time_before_sleep IS NULL OR u.screen_time_before_sleep &lt; 0 OR u.screen_time_before_sleep > 24 THEN 'Temps ecran avant sommeil invalide'
        WHEN w.sleep_hours IS NULL OR w.sleep_hours &lt; 0 OR w.sleep_hours > 24 THEN 'Sommeil invalide'
        WHEN w.stress_level IS NULL OR w.stress_level &lt; 0 OR w.stress_level > 10 THEN 'Stress invalide'
        WHEN w.anxiety_level IS NULL OR w.anxiety_level &lt; 0 OR w.anxiety_level > 10 THEN 'Anxiete invalide'
        WHEN w.addiction_level IS NULL OR w.addiction_level &lt; 0 OR w.addiction_level > 10 THEN 'Addiction invalide'
        WHEN w.depression_label IS NULL OR w.depression_label NOT IN (0, 1) THEN 'Depression label invalide'
        ELSE NULL
    END AS rejection_reason

FROM stg_adolescents_usage u
JOIN stg_wellbeing_indicators w
    ON u.id_adolescent = w.id_adolescent
JOIN stg_school_lifestyle sc
    ON u.id_adolescent = sc.id_adolescent;</sql>
